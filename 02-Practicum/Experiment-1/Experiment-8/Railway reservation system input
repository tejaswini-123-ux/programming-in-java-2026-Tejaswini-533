
class TicketBooking {
    String passengerName;
    String bookingStatus;

    
    TicketBooking(String passengerName) {
        this.passengerName = passengerName;
        this.bookingStatus = "Processing";
    }

    
    synchronized void displayBookingDetails() {
        System.out.println("Passenger Name : " + passengerName);
        System.out.println("Booking Status : " + bookingStatus);
        System.out.println("Thread Name    : " + Thread.currentThread().getName());
        System.out.println("Thread ID      : " + Thread.currentThread().getId());
        System.out.println("----------------------------------");
    }


       synchronized void bookTicket() {
        System.out.println(
            Thread.currentThread().getName()
            + " is booking ticket for " + passengerName
        );

        try {
            Thread.sleep(500);
        } catch (InterruptedException e) {
            System.out.println("Thread interrupted.");
        }

        bookingStatus = "Confirmed";
        displayBookingDetails();
    }
}



class BookingThread extends Thread {

    TicketBooking booking;

    BookingThread(TicketBooking booking, String threadName) {
        super(threadName);
        this.booking = booking;
    }

    
    @Override
    public void run() {
        booking.bookTicket();
    }
}



class BookingRunnable implements Runnable {

    TicketBooking booking;

    BookingRunnable(TicketBooking booking) {
        this.booking = booking;
    }

    
    @Override
    public void run() {
        booking.bookTicket();
    }
}



public class RailwayReservation {

    public static void main(String[] args) {

        
        TicketBooking booking1 = new TicketBooking("Rahul");
        TicketBooking booking2 = new TicketBooking("Priya");
        TicketBooking booking3 = new TicketBooking("Aman");
        TicketBooking booking4 = new TicketBooking("Neha");

        
        BookingThread t1 =
            new BookingThread(booking1, "Rahul-Thread");

        BookingThread t2 =
            new BookingThread(booking2, "Priya-Thread");

        
        BookingRunnable runnable3 =
            new BookingRunnable(booking3);

        BookingRunnable runnable4 =
            new BookingRunnable(booking4);

        Thread t3 =
            new Thread(runnable3, "Aman-Thread");

        Thread t4 =
            new Thread(runnable4, "Neha-Thread");

        
        t1.start();
        t2.start();
        t3.start();
        t4.start();

        
        try {
            t1.join();
            t2.join();
            t3.join();
            t4.join();
        } catch (InterruptedException e) {
            System.out.println("Main thread interrupted.");
          
        }

        // Final message
        System.out.println("\nAll passenger booking requests have been processed successfully.");
    }
}
